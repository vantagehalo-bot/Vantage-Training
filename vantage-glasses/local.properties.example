# Copy to local.properties (which git ignores) and fill in. Never commit the real file.
sdk.dir=/Users/you/Library/Android/sdk

# Meta Model API (dev.meta.ai). Used by Vantage to describe the frame.
meta_api_key=
meta_model_id=muse-spark-1.3
meta_api_base=https://api.meta.ai/v1

# Any OpenAI-compatible vision model works as a stand-in. Google Gemini (key from aistudio.google.com):
#   meta_api_key=AIza...
#   meta_api_base=https://generativelanguage.googleapis.com/v1beta/openai
#   meta_model_id=gemini-2.5-flash
# OpenAI:
#   meta_api_base=https://api.openai.com/v1
#   meta_model_id=gpt-4o-mini

# Device Access Toolkit credentials. Leave empty while testing on the Mock Device Kit or with
# Developer Mode on in the Meta AI app.
mwdat_application_id=
mwdat_client_token=
